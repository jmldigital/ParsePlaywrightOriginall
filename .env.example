# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-with-a-random-token-at-least-24-characters
CAPTCHA_API_KEY=
GLOBAL_CONCURRENCY=2
DATABASE_PATH=data/jobs.sqlite3
ITEM_TIMEOUT_SECONDS=180
RETENTION_HOURS=50
MAX_ACTIVE_JOBS=100
API_PORT=8000
# Optional Playwright storage_state JSON; mount read-only in Compose if required.
# STPARTS_STORAGE_STATE=/app/secrets/stparts-state.json

# Save up to 20 source-error bundles next to the database (diagnostics/).
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_MAX_SAMPLES=20
